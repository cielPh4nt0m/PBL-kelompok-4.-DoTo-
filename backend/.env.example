# Koneksi MySQL/MariaDB. Untuk XAMPP biasanya DB_USER=root dan DB_PASS kosong.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=doto
DB_USER=doto
DB_PASS=doto

# Set true kalau situs dilayani lewat HTTPS.
COOKIE_SECURE=false

# Google OAuth & Gemini AI Studio
GOOGLE_CLIENT_ID=
AI_PROVIDER=gemini
AI_MODEL=gemini-4-hydrogen
AI_THINKING_LEVEL=MEDIUM
GEMINI_API_KEY=
